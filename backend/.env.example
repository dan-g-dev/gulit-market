PORT=4000
NODE_ENV=development

# MySQL connection (see database/schema.sql for the table definitions)
DB_HOST=localhost
DB_PORT=3306
DB_USER=gulit
DB_PASSWORD=gulit_dev_password
DB_NAME=gulit_market

# Secret used to sign JWTs — replace with a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:3000

# --- Ethiopian payments ---------------------------------------------------
# Cash on Delivery needs no configuration and always works.
#
# TeleBirr requires real merchant credentials. Until these are filled in,
# the TeleBirr provider reports itself as "not configured" rather than
# faking a successful payment — see src/services/payments/telebirrProvider.js
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_SHORT_CODE=
TELEBIRR_CALLBACK_URL=
